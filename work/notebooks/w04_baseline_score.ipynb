   "cell_type": "markdown",
   "metadata": {},
   "source": "## 1. My rule and its reason codes\n\n*Rule: Give each page a higher score when it has enough search visibility and shows either staleness or a CTR opportunity. Higher scores mean the page should be reviewed first.
Reason codes: stale_visible_page, low_ctr_visible_page, stale_and_low_ctr, no_action.*"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
import pandas as pd
import numpy as np

# Load the starter dataset
df = pd.read_csv("../../data/raw/content_refresh_anonymized.csv")

# Two signals used by the rule
df["is_stale"] = df["content_age_days"] >= 180
df["has_visibility"] = df["impressions_90d"] >= 500
df["low_ctr"] = (
    (df["impressions_90d"] >= 500) &
    (df["avg_position"] > 0) &
    (df["avg_position"] <= 20) &
    (df["ctr"] < 0.5)
)

# Score
df["score"] = (
    df["is_stale"].astype(int) * 2 +
    df["low_ctr"].astype(int) * 2 +
    df["has_visibility"].astype(int)
)

# Reason code
df["reason_code"] = "no_action"

df.loc[
    df["is_stale"] & df["low_ctr"],
    "reason_code"
] = "stale_and_low_ctr"

df.loc[
    df["is_stale"] & ~df["low_ctr"],
    "reason_code"
] = "stale_visible_page"

df.loc[
    ~df["is_stale"] & df["low_ctr"],
    "reason_code"
] = "low_ctr_visible_page"

# Action
df["action"] = "monitor"

df.loc[
    df["reason_code"] == "stale_visible_page",
    "action"
] = "refresh"

df.loc[
    df["reason_code"] == "low_ctr_visible_page",
    "action"
] = "fix_ctr"

df.loc[
    df["reason_code"] == "stale_and_low_ctr",
    "action"
] = "refresh"

print(df[["score", "reason_code", "action"]].head())
   ]
